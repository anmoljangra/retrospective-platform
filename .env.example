# Environment configuration for RetroSpace
NODE_ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=4000

# PostgreSQL Database Configuration
POSTGRES_DB=retrospace
POSTGRES_USER=retrospace
POSTGRES_PASSWORD=retrospace_local_dev_password
DATABASE_URL=postgresql://retrospace:retrospace_local_dev_password@db:5432/retrospace

# CORS & URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# Security Secrets (Must be min 32 chars in production)
JWT_SECRET=retrospace_dev_jwt_access_secret_32_characters_minimum
JWT_REFRESH_SECRET=retrospace_dev_jwt_refresh_secret_32_characters_minimum
COOKIE_SECRET=retrospace_dev_cookie_secret_32_characters_minimum

